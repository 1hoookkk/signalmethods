{
  "profile": "trenchprofile-v1",
  "family": "acid-resonant",
  "description": "TB-303 style resonant lowpass + bass processor filters. Measured from P2K corpus: resonance 5-39 dB, cutoff floor 20 Hz, morph travel 0-5 oct, max pole radius 0.997-0.999. Reference presets: MegaSweepz, BassBox-303, EarlyRizer, LucifersQ, AcidRavage, Millennium, KlubKlassik, DeadRinger, TB-OrNot-TB, ToothComb.",

  "frequency_domain": {
    "cutoff_range_hz": [20, 8000],
    "morph_axis_semantic": "cutoff_sweep_or_bass_character",
    "q_axis_semantic": "resonance_intensity",
    "min_cutoff_hz": 20,
    "max_cutoff_hz": 12000
  },

  "resonance_budget": {
    "max_resonance_db": 40.0,
    "q0_default_resonance_db": 8.0,
    "corner_reg_weight": 0.05
  },

  "q_attitude_rules": {
    "allowed_behaviours": ["arm", "flat"],
    "max_arm_delta_r": 0.3,
    "q_axis_max_octave_shift": 1.5
  },

  "voice_roles": {
    "required": ["anchor"],
    "bands": {
      "anchor": [20, 400],
      "mouth": [200, 8000],
      "air": [2000, 12000],
      "terminal": [2000, 12000]
    }
  },

  "guide_pose_constraints": {
    "min_cutoff_hz": 20,
    "max_cutoff_hz": 12000,
    "max_targets_per_guide": 2
  },

  "verification": {
    "min_cutoff_travel_octaves": 3.0,
    "max_bass_loss_db": 3.0,
    "min_peak_count_morph_range": [1, 7]
  }
}
