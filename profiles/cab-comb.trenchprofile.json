{
  "profile": "trenchprofile-v1",
  "family": "cab-comb",
  "description": "Narrow, closely-spaced resonant peaks mimicking physical acoustic spaces. Speaker cabinet and room comb-filter responses.",

  "frequency_domain": {
    "cutoff_range_hz": [60, 8000],
    "morph_axis_semantic": "cabinet_blend",
    "q_axis_semantic": "room_depth",
    "min_cutoff_hz": 30,
    "max_cutoff_hz": 12000
  },

  "resonance_budget": {
    "max_resonance_db": 10.0,
    "q0_default_resonance_db": 2.0,
    "corner_reg_weight": 0.25
  },

  "q_attitude_rules": {
    "allowed_behaviours": ["arm", "flat"],
    "max_arm_delta_r": 0.1,
    "q_axis_max_octave_shift": 1.0
  },

  "voice_roles": {
    "required": ["anchor"],
    "bands": {
      "anchor": [30, 200],
      "mouth": [100, 2000],
      "air": [1000, 8000],
      "terminal": [2000, 12000]
    }
  },

  "guide_pose_constraints": {
    "min_cutoff_hz": 30,
    "max_cutoff_hz": 12000,
    "max_targets_per_guide": 2
  },

  "verification": {
    "min_cutoff_travel_octaves": 2.0,
    "max_bass_loss_db": 3.0,
    "min_peak_count_morph_range": [3, 12]
  }
}
