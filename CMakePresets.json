{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "Python3_EXECUTABLE": "$env{TRENCH_PYTHON313}",
        "PYBIND11_FINDPYTHON": "ON",
        "VCPKG_OVERLAY_PORTS": "$env{TRENCH_VCPKG_OVERLAYS}"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "Python3_EXECUTABLE": "$env{TRENCH_PYTHON313}",
        "PYBIND11_FINDPYTHON": "ON",
        "VCPKG_OVERLAY_PORTS": "$env{TRENCH_VCPKG_OVERLAYS}",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_HOST_TRIPLET": "x64-windows-release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-release"
      }
    },
    {
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-release",
        "VCPKG_MANIFEST_FEATURES": "gui",
        "TRENCH_BUILD_APP": "ON"
      },
      "name": "app",
      "displayName": "Workstation app (Qt)",
      "binaryDir": "${sourceDir}/out/build/app"
    },
    {
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-release",
        "TRENCH_BUILD_APP": "OFF"
      },
      "name": "vst3",
      "displayName": "Plugin (VST3 + FaceShot)",
      "binaryDir": "${sourceDir}/out/build/vst3"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "app",
      "configurePreset": "app",
      "targets": [
        "trench_native",
        "trench_native_tests"
      ]
    },
    {
      "name": "vst3",
      "configurePreset": "vst3",
      "targets": [
        "TRENCH_VST3",
        "TRENCH_FaceShot"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "app",
      "configurePreset": "app",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
